{
  "name": "fitness-jeff",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Fitness Jeff: app personal de progreso, entrenamiento, hidratación y recomendaciones.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "bot:check": "playwright test tests/e2e/temporary-user-bot.spec.ts",
    "audit": "npm audit --audit-level=high",
    "cloudflare:check": "wrangler pages functions build functions --outfile .wrangler/pages-functions.js",
    "check": "npm run typecheck && npm run test && npm run build",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "android:init": "tauri android init",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build",
    "cloudflare:dev": "wrangler pages dev dist",
    "cloudflare:deploy": "npm run build && wrangler pages deploy dist"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.110.8",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-deep-link": "2.4.9",
    "@tauri-apps/plugin-opener": "2.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@tauri-apps/cli": "2.11.4",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "wrangler": "4.120.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
