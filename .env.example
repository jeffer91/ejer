# Supabase: valores públicos del proyecto. Nunca uses service_role aquí.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REEMPLAZAR

# URL pública de Cloudflare para las compilaciones Tauri.
# En web puede quedar vacía para usar /api del mismo dominio.
VITE_API_BASE_URL=

# El callback HTTPS se usa en web; el callback custom se usa en Tauri.
VITE_WEB_AUTH_REDIRECT=https://TU-APP.pages.dev
VITE_NATIVE_AUTH_REDIRECT=fitnessjeff://auth/callback
